# WildGuard Report AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ── OpenRouter API (required for live AI reports) ──────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use — fast free model recommended
# See available models at https://openrouter.ai/models
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# ── Flask security ──────────────────────────────────────────────────────────
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# ── Site URL (used in OpenRouter HTTP-Referer header) ──────────────────────
# For local development leave as-is. Set to your deployed URL in production.
SITE_URL=http://localhost:5000
